<UserControl x:Class="WalletCopy.Controls.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             IsHitTestVisible="False">
    <Border x:Name="ToastCard" Width="410" Margin="0,14,22,0" Padding="14,13"
            Background="{DynamicResource ThemePanelRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
            CornerRadius="13" Visibility="Collapsed" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SeverityBar" VerticalAlignment="Stretch"
                    Background="{DynamicResource ThemeAccent}" CornerRadius="2"/>
            <Border x:Name="IconCircle" Grid.Column="2" Width="30" Height="30"
                    CornerRadius="15" VerticalAlignment="Top" Margin="0,1,0,0">
                <TextBlock x:Name="IconText" Text="✓" Width="30" Height="30"
                           FontFamily="Arial" FontSize="16" FontWeight="Bold"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFFFFFFF"/>
            </Border>
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,0,0">
                <TextBlock x:Name="TitleText" Text="Sucesso" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Left" TextAlignment="Left"/>
                <TextBlock x:Name="MessageText" Text="" FontSize="11" Foreground="{DynamicResource ThemeMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="320" LineHeight="16"
                           HorizontalAlignment="Left" TextAlignment="Left"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
