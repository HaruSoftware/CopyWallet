<UserControl x:Class="WalletCopy.Pages.PaperTradingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WalletCopy.Models"
             Background="Transparent" FontFamily="Arial">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,25,28,30">
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Terminal simulado" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Mercados públicos, execução contra o book e liquidação virtual. Ordens nunca são enviadas."
                               Foreground="{DynamicResource ThemeSecondary}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource ThemeSuccessBackground}"
                        BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                        CornerRadius="10" Padding="11,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccent}" Margin="0,0,8,0"/>
                        <TextBlock Text="PAPER ACCOUNT" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeAccent}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="11" Padding="13,11">
                    <StackPanel>
                        <TextBlock Text="SALDO DISPONÍVEL" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="BalanceText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="11" Padding="13,11">
                    <StackPanel>
                        <TextBlock Text="VALOR EM POSIÇÕES" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="PositionValueText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="11" Padding="13,11">
                    <StackPanel>
                        <TextBlock Text="PNL NÃO REALIZADO" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="UnrealizedPnlText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="11" Padding="13,11">
                    <StackPanel>
                        <TextBlock Text="PNL REALIZADO" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="RealizedPnlText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.92*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="15">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="145"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MarketSearchInput" Height="36" Padding="10,0"
                                         VerticalContentAlignment="Center" TextChanged="MarketSearchInput_TextChanged"
                                         ToolTip="Buscar eventos e mercados"/>
                                <ComboBox x:Name="MarketFilterSelector" Grid.Column="2" Height="36"
                                          SelectionChanged="MarketFilterSelector_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="Todos"/>
                                    <ComboBoxItem Content="Rápidos"/>
                                    <ComboBoxItem Content="Em alta"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="EVENTOS PÚBLICOS · SELECIONE PARA ABRIR"
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource ThemeSecondary}" Margin="2,14,0,7"/>
                        </StackPanel>
                        <ListBox x:Name="MarketSelector" Height="480"
                                 SelectionChanged="MarketSelector_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:MarketCard}">
                                    <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="9" Padding="11,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxHeight="34"/>
                                                <TextBlock Text="{Binding EventTitle}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding VolumeLabel}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Top"
                                                    Background="{DynamicResource ThemeSuccessBackground}"
                                                    CornerRadius="6" Padding="7,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TimeframeLabel}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TimeframeLabel}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource ThemeAccent}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Ticket de ordem" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Simulação preenchida com liquidez pública do book."
                                           FontSize="10" Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectedMarketTimer" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="10" Foreground="{DynamicResource ThemeAccent}"/>
                        </Grid>
                        <TextBlock x:Name="SelectedMarketText" Text="Clique em um evento para abrir o mercado"
                                   Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,16,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="MarketStreamIndicator" Width="6" Height="6"
                                     Fill="{DynamicResource ThemeDim}" Margin="0,0,7,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="MarketStreamStatus" Text="Nenhum mercado selecionado"
                                       FontSize="9" Foreground="{DynamicResource ThemeSecondary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="OUTCOME" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <ComboBox x:Name="OutcomeSelector" Height="36" Margin="0,7,0,12"
                                  DisplayMemberPath="Name" SelectionChanged="OutcomeSelector_SelectionChanged"/>

                        <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="9" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MELHOR BID" FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeSecondary}"/>
                                    <TextBlock x:Name="BestBidText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="MELHOR ASK" FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeSecondary}"/>
                                    <TextBlock x:Name="BestAskText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SPREAD" FontSize="8" FontWeight="Bold"
                                               Foreground="{DynamicResource ThemeSecondary}"/>
                                    <TextBlock x:Name="SpreadText" Text="—" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Margin="0,12,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AÇÃO" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <ComboBox x:Name="SideSelector" Height="36" Margin="0,7,0,0"
                                          SelectionChanged="SideSelector_SelectionChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="BUY"/>
                                    <ComboBoxItem Content="SELL"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TIPO DE ORDEM" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <ComboBox x:Name="OrderTypeSelector" Height="36" Margin="0,7,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="FOK"/>
                                    <ComboBoxItem Content="FAK"/>
                                    <ComboBoxItem Content="GTC"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SHARES" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBox x:Name="SharesInput" Height="36" Margin="0,7,0,0"
                                         Padding="9,0" VerticalContentAlignment="Center" Text="10"
                                         TextChanged="OrderInput_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PREÇO LIMITE" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBox x:Name="PriceInput" Height="36" Margin="0,7,0,0"
                                         Padding="9,0" VerticalContentAlignment="Center" Text="0.50"
                                         TextChanged="PriceInput_TextChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="OrderEstimateText" FontSize="10"
                                   Foreground="{DynamicResource ThemeSecondary}" Margin="0,9,0,0"/>
                        <CheckBox x:Name="SplitCheckBox" Content="Simular split de dois outcomes"
                                  Margin="0,12,0,0"/>
                        <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ThemeError}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button x:Name="SimulateButton" Content="Simular ordem" Click="Simulate_Click"
                                Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="0,14,0,0" IsEnabled="False"/>
                        <TextBlock Text="BOOK · 5 NÍVEIS" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}" Margin="0,17,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BidDepthText" FontSize="9" Foreground="{DynamicResource ThemeAccent}"
                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AskDepthText" Grid.Column="2" FontSize="9"
                                       Foreground="{DynamicResource ThemeError}" FontFamily="Consolas"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Posições simuladas" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="PositionList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PaperPosition}">
                                    <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="9"
                                            Padding="11,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MarketTitle}" FontSize="11" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding PositionLabel}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding Status}" FontSize="8"
                                                           Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ValueLabel}" FontSize="11"
                                                           FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding PnlLabel}" FontSize="10"
                                                           Foreground="{DynamicResource ThemeAccent}"
                                                           HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PositionsEmptyState" Text="Nenhuma posição simulada aberta."
                                   Foreground="{DynamicResource ThemeSecondary}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="10"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Ordens recentes" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="OrderList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PaperOrder}">
                                    <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="9"
                                            Padding="11,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding MarketTitle}" FontSize="11" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TradeLabel}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalCost, StringFormat={}{0:C2}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <Button Content="Cancelar GTC" Tag="{Binding Id}"
                                                        Click="CancelOrder_Click" FontSize="9" Padding="7,4"
                                                        Margin="0,5,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Open">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Partial fill">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="OrdersEmptyState" Text="Nenhuma ordem simulada ainda."
                                   Foreground="{DynamicResource ThemeSecondary}" FontSize="10"
                                   HorizontalAlignment="Center" Margin="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
