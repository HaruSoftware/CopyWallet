<UserControl x:Class="WalletCopy.Pages.PaperTradingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="Arial">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,25,28,30">
            <TextBlock Text="Terminal simulado" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Opere com mercados públicos em uma conta virtual. Nenhuma ordem é enviada."
                       Foreground="{DynamicResource ThemeSecondary}" FontSize="12" Margin="0,5,0,20"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Mercados públicos" FontSize="16" FontWeight="SemiBold"/>
                        <ListBox x:Name="MarketSelector" Height="360" Margin="0,12,0,0"
                                 SelectionChanged="MarketSelector_SelectionChanged"
                                 DisplayMemberPath="Title"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                        BorderThickness="1" CornerRadius="14" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Nova ordem simulada" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedMarketText" Text="Selecione um mercado"
                                   Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,5,0,16"/>
                        <TextBlock Text="OUTCOME" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource ThemeSecondary}"/>
                        <ComboBox x:Name="OutcomeSelector" Height="36" Margin="0,7,0,12"
                                  DisplayMemberPath="Name"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SHARES" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBox x:Name="SharesInput" Height="36" Margin="0,7,0,0"
                                         Padding="9,0" VerticalContentAlignment="Center" Text="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PREÇO" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBox x:Name="PriceInput" Height="36" Margin="0,7,0,0"
                                         Padding="9,0" VerticalContentAlignment="Center" Text="0.50"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="TIPO" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <ComboBox x:Name="OrderTypeSelector" Height="36" Margin="0,7,0,0"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="FOK"/>
                                    <ComboBoxItem Content="FAK"/>
                                    <ComboBoxItem Content="GTC"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SLIPPAGE %" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBox x:Name="SlippageInput" Height="36" Margin="0,7,0,0"
                                         Padding="9,0" VerticalContentAlignment="Center" Text="1"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="SplitCheckBox" Content="Simular split (dois outcomes)"
                                  Margin="0,14,0,0"/>
                        <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ThemeError}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button Content="Simular ordem" Click="Simulate_Click"
                                Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}"
                                HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Conta virtual" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                        <TextBlock Text="Saldo: " Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="BalanceText" FontWeight="SemiBold"/>
                        <TextBlock Text="    Exposição: " Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock x:Name="ExposureText" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ItemsControl x:Name="OrderList"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
