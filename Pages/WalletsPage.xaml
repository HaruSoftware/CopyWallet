<UserControl x:Class="WalletCopy.Pages.WalletsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:models="clr-namespace:WalletCopy.Models"
             Background="Transparent" FontFamily="Arial">
    <UserControl.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,25,28,30">
            <TextBlock Text="Carteiras" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Adicione endereços públicos e acompanhe trades e posições."
                       Foreground="{DynamicResource ThemeSecondary}" FontSize="12" Margin="0,5,0,20"/>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Monitorar um player" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Insira o endereço público da carteira que deseja acompanhar."
                               FontSize="11" Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TrackedWalletInput" Height="50"
                                 Padding="14,0"
                                 FontSize="13"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 ui:ControlHelper.PlaceholderText="Cole aqui o endereço público (0x...)"
                                 KeyDown="TrackedWalletInput_KeyDown"/>
                        <Button Grid.Column="2" Content="＋  Adicionar carteira" Background="{DynamicResource ThemeAccent}"
                                Foreground="{DynamicResource ThemeAccentText}" Height="50" Click="TrackWallet_Click"/>
                    </Grid>
                    <TextBlock Text="Aceitamos somente endereços públicos. Nunca informe uma chave privada."
                               FontSize="10" Foreground="{DynamicResource ThemeSecondary}" Margin="2,9,0,0"/>
                    <Border Background="{DynamicResource ThemeBorder}" Height="1" Margin="0,18,0,15"/>
                    <TextBlock Text="MINHA CARTEIRA · OPCIONAL" FontSize="9" Foreground="{DynamicResource ThemeSecondary}"
                               FontWeight="Bold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OwnWalletInput" Height="42"
                                 Padding="14,0"
                                 FontSize="13"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Center"
                                 ui:ControlHelper.PlaceholderText="Seu endereço público para consultar posições"
                                 KeyDown="OwnWalletInput_KeyDown"/>
                        <Button Grid.Column="2" Content="Salvar minha carteira" Background="{DynamicResource ThemeControl}"
                                Height="42" Click="SetOwnWallet_Click"/>
                    </Grid>
                    <TextBlock x:Name="OwnWalletStatus" Text="Nenhuma carteira própria vinculada."
                               FontSize="10" Foreground="{DynamicResource ThemeSecondary}"
                               Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Carteiras acompanhadas" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Selecione um endereço para abrir suas posições."
                                       FontSize="11" Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="WalletCount" Grid.Column="1" Text="0 monitoradas"
                                   FontSize="10" Foreground="{DynamicResource ThemeSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="TrackedWalletList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TrackedWallet}">
                                <Border Background="{DynamicResource ThemePanelRaised}" BorderBrush="{DynamicResource ThemeBorderStrong}" BorderThickness="1"
                                        CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch"
                                        Tag="{Binding Address}" MouseLeftButtonUp="TrackedWalletCard_MouseLeftButtonUp">
                                    <Grid MinHeight="38" MouseEnter="TrackedWalletCard_MouseEnter"
                                          MouseLeave="TrackedWalletCard_MouseLeave">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ThemeAccent}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Address}" FontSize="10"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="Novos" Tag="{Binding Address}"
                                                      IsChecked="{Binding IsAutoCopyEnabled}"
                                                      FontSize="9" Foreground="{DynamicResource ThemeSecondary}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      Checked="AutoCopy_Checked" Unchecked="AutoCopy_Unchecked"/>
                                            <Button Content="Copiar tudo" Tag="{Binding Address}"
                                                    Padding="7,4" FontSize="9"
                                                    Background="{DynamicResource ThemeControl}"
                                                    Click="CopyAllTrades_Click"/>
                                            <Button x:Name="RemoveWalletButton" Content="×" Tag="{Binding Address}"
                                                    Width="28" Height="28" Padding="0" Margin="4,0,0,0"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="Transparent" Foreground="{DynamicResource ThemeSecondary}"
                                                    FontSize="15" ToolTip="{Binding Address}" Click="RemoveWallet_Click"
                                                    Opacity="0" IsHitTestVisible="False"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WalletEmptyState" Text="Nenhuma carteira adicionada. Cole um endereço acima para começar."
                               FontSize="11" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="18,15"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ThemeBackground}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="14"
                    Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="18,16,18,14">
                        <TextBlock Text="Atividade da carteira" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FocusedWalletAddress" Text="Selecione uma carteira monitorada"
                                   FontSize="12" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource ThemeBorder}"/>
                    <Grid Grid.Row="2" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PositionsTab" Content="Positions" Click="PositionsTab_Click"
                                Background="Transparent" Foreground="{DynamicResource ThemeMuted}" FontSize="15"
                                Width="94" Padding="2,12,2,10" Margin="0,0,8,0"
                                BorderThickness="0" BorderBrush="Transparent"/>
                        <Button x:Name="ActivityTab" Grid.Column="1" Content="Activity" Click="ActivityTab_Click"
                                Background="Transparent" Foreground="{DynamicResource ThemeText}" FontSize="15"
                                Width="82" Padding="2,12,2,10" Margin="0,0,8,0"
                                BorderThickness="0,0,0,2" BorderBrush="{DynamicResource ThemeAccent}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="ActivityFilter" Width="132" Height="32"
                                      SelectedValuePath="Tag" SelectionChanged="ActivityFilter_SelectionChanged">
                                <ComboBoxItem Tag="All" Content="Todos os trades"/>
                                <ComboBoxItem Tag="BUY" Content="Somente compras"/>
                                <ComboBoxItem Tag="SELL" Content="Somente vendas"/>
                            </ComboBox>
                            <ComboBox x:Name="PositionSort" Width="132" Height="32"
                                      SelectedValuePath="Tag" Visibility="Collapsed"
                                      SelectionChanged="PositionSort_SelectionChanged">
                                <ComboBoxItem Tag="Value" Content="Maior valor"/>
                                <ComboBoxItem Tag="Pnl" Content="Maior PnL"/>
                            </ComboBox>
                            <TextBlock x:Name="WalletDataStatus" Text="Aguardando dados"
                                       Width="150" FontSize="10" Foreground="{DynamicResource ThemeSecondary}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0,4,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Background="{DynamicResource ThemeBorder}"/>
                    <Grid Grid.Row="4" MinHeight="180">
                        <Grid x:Name="ActivityPanel">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                                    <ItemsControl x:Name="ActivityList" AlternationCount="2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:WalletTrade}">
                                                <Border CornerRadius="10" Margin="8,3" Padding="14,11">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                                             Value="1">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemePanelRaised}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid MinHeight="86">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="82"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="190"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SideLabel}" Grid.Column="0"
                                                                   FontSize="15" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="1,0"/>
                                                        <Border Grid.Column="1" Width="64" Height="64"
                                                                Background="{DynamicResource ThemeControl}" CornerRadius="9">
                                                            <Image Source="{Binding MarketImageUrl}" Stretch="UniformToFill"
                                                                   SnapsToDevicePixels="True"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   ClipToBounds="True"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MarketTitle}" FontSize="14" LineHeight="17"
                                                                       FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"
                                                                       TextWrapping="Wrap" TextAlignment="Left"
                                                                       MaxWidth="680"/>
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Left" Margin="0,5,0,0">
                                                                <Border CornerRadius="7" Padding="7,3"
                                                                        Margin="0,0,8,0"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource ThemeSuccessBackground}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                                                    <Setter Property="Background" Value="{DynamicResource ThemeErrorBackground}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding OutcomePriceLabel}"
                                                                               FontSize="12" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsBuy}" Value="False">
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeError}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding SharesLabel}" FontSize="12"
                                                                           Foreground="{DynamicResource ThemeMuted}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding AmountLabel}" FontSize="16"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding NetAmountLabel}" FontSize="11"
                                                                       Foreground="{DynamicResource ThemeMuted}" HorizontalAlignment="Right"
                                                                       Margin="0,3,0,0"/>
                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Right" Margin="0,4,0,0">
                                                                <TextBlock Text="{Binding TimeAgoLabel}" FontSize="11"
                                                                           Foreground="{DynamicResource ThemeMuted}"/>
                                                                <TextBlock Text="  ↗" FontSize="12" Foreground="{DynamicResource ThemeMuted}"/>
                                                            </StackPanel>
                                                            <Button Content="{Binding CopyActionLabel}" DataContext="{Binding}"
                                                                    Click="CopyTrade_Click" Padding="8,4" FontSize="9"
                                                                    HorizontalAlignment="Right" Margin="0,5,0,0">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="ActivityEmptyState"
                                           Text="Selecione uma carteira para acompanhar as atividades."
                                           FontSize="14" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22"/>
                            </Grid>
                        </Grid>
                        <Grid x:Name="PositionPanel" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <ItemsControl x:Name="PositionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:WalletPosition}">
                                            <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="11" Margin="8,4"
                                                    Padding="12,11">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="46"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="112"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="44" Height="44" Background="{DynamicResource ThemeBorder}" CornerRadius="9">
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                                                               SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MarketTitle}" FontSize="12"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding Outcome}" FontSize="10"
                                                                       Foreground="{DynamicResource ThemeNav}"/>
                                                            <TextBlock Text="  ·  " FontSize="10" Foreground="{DynamicResource ThemeLabel}"/>
                                                            <TextBlock Text="{Binding SharesLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource ThemeMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ValueLabel}" FontSize="13"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding PnlLabel}" FontSize="10"
                                                                   HorizontalAlignment="Right" Margin="0,4,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPnlPositive}" Value="False">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeError}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="PositionEmptyState"
                                       Text="Selecione uma carteira para consultar posições."
                                       FontSize="12" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
