<UserControl x:Class="WalletCopy.Pages.WalletAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:models="clr-namespace:WalletCopy.Models"
             Background="Transparent" FontFamily="Arial">
    <UserControl.Resources>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemePanel}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondary}"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,25,28,30">
            <TextBlock Text="Análise de carteira" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Consulte os trades recentes e veja uma leitura indicativa do estilo de operação."
                       Foreground="{DynamicResource ThemeSecondary}" FontSize="12" Margin="0,5,0,20"/>
            <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Selecionar carteira ou pesquisar endereço" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="A pesquisa por endereço é avulsa: não adiciona nem salva a carteira no acompanhamento."
                               FontSize="11" Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="WalletPicker" Height="44" Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  ui:ControlHelper.PlaceholderText="Carteiras existentes"
                                  SelectionChanged="WalletPicker_SelectionChanged"/>
                        <TextBox x:Name="AddressInput" Grid.Column="2" Height="44" Padding="12,0"
                                 FontSize="12" VerticalContentAlignment="Center"
                                 ui:ControlHelper.PlaceholderText="Cole um endereço público (0x...)"
                                 KeyDown="AddressInput_KeyDown"/>
                        <Button x:Name="AnalyzeButton" Grid.Column="4" Content="Analisar carteira"
                                Background="{DynamicResource ThemeAccent}" Foreground="{DynamicResource ThemeAccentText}"
                                Height="44" Padding="18,0" Click="Analyze_Click"/>
                    </Grid>
                    <TextBlock x:Name="StatusText" Text="Selecione uma carteira existente ou informe um endereço."
                               FontSize="10" Foreground="{DynamicResource ThemeSecondary}" Margin="2,10,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="AnalysisPanel" Style="{StaticResource PanelCard}" Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="RELATÓRIO DOS TRADES RECENTES" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeSecondary}"/>
                    <TextBlock x:Name="TradeWindowText" Text="Últimos trades" FontSize="12"
                               Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,14"/>
                    <Border x:Name="ProfitabilityCard" Background="{DynamicResource ThemeBackground}"
                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PNL REALIZADO ESTIMADO NA AMOSTRA"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeSecondary}"/>
                                <TextBlock x:Name="ProfitabilityStatusText" Text="Sem resultado estimável"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="ProfitabilitySummaryText" Text="" FontSize="10"
                                           Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" MinWidth="155" VerticalAlignment="Center">
                                <TextBlock x:Name="RealizedResultText" Text="—" FontSize="25"
                                           FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="MatchedInvestmentText" Text="" FontSize="9"
                                           Foreground="{DynamicResource ThemeSecondary}"
                                           HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                <TextBlock x:Name="AverageResultText" Text="" FontSize="9"
                                           Foreground="{DynamicResource ThemeSecondary}"
                                           HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,0,0,18">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="APORTE BRUTO EM COMPRAS" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="GrossBuyAmountText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="Soma do valor bruto das compras na amostra."
                                       FontSize="9" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="RETORNO SOBRE CUSTO PAREADO" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="ReturnOnInvestmentText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                            <TextBlock Text="Resultado dividido pelo custo das compras que casaram com vendas."
                                       FontSize="9" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PERÍODO ENTRE TRADES" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="PeriodText" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Do trade mais antigo ao mais recente nesta amostra."
                                       FontSize="9" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,3,8,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="LEITURA DE PERFIL" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeSecondary}"/>
                    <TextBlock x:Name="ProfileText" Text="—" FontSize="21" FontWeight="Bold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="SummaryText" Text="" FontSize="12"
                               Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock x:Name="EvidenceText" Text="" FontSize="11"
                               Foreground="{DynamicResource ThemeMuted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <UniformGrid Columns="4" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="TRADES ANALISADOS" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TradeCountText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MERCADOS" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="MarketCountText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="VALOR MÉDIO / TRADE" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="AverageTradeValueText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="EXECUÇÕES TAKER" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="TakerPercentageText" Text="—" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="O resultado FIFO só cruza compras e vendas do mesmo token presentes nos últimos 30 trades. Não representa o PnL total da carteira: posições compradas antes da amostra e taxas indisponíveis podem alterar o resultado."
                               FontSize="10" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Text="Trades recentes" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Execuções públicas mais recentes retornadas pela Polymarket Data API."
                               FontSize="11" Foreground="{DynamicResource ThemeSecondary}" Margin="0,4,0,12"/>
                    <TextBlock x:Name="TradesEmptyText" Text="Nenhuma consulta realizada."
                               FontSize="11" Foreground="{DynamicResource ThemeSecondary}" Margin="0,8"/>
                    <ItemsControl x:Name="TradeList" AlternationCount="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:WalletTrade}">
                                <Border CornerRadius="9" Margin="0,2" Padding="12,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}"
                                                             Value="1">
                                                    <Setter Property="Background" Value="{DynamicResource ThemePanelRaised}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SideLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0">
                                            <TextBlock Text="{Binding MarketTitle}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding OutcomePriceLabel}" FontSize="10"
                                                       Foreground="{DynamicResource ThemeSecondary}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AmountLabel}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SharesLabel}" FontSize="9"
                                                       Foreground="{DynamicResource ThemeSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimestampLabel}" FontSize="9"
                                                       Foreground="{DynamicResource ThemeSecondary}"/>
                                            <TextBlock Text="{Binding TimeAgoLabel}" FontSize="9"
                                                       Foreground="{DynamicResource ThemeMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding ExecutionRoleLabel}" FontSize="9"
                                                   Foreground="{DynamicResource ThemeSecondary}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
