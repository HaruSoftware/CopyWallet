<UserControl x:Class="WalletCopy.Pages.CopyTradesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WalletCopy.Models"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,25,28,30">
            <TextBlock Text="Trades copiados" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Histórico de ordens reais submetidas ao CLOB da Polymarket e registros de simulação."
                       Foreground="{DynamicResource ThemeSecondary}" FontSize="12" Margin="0,5,0,16"/>

            <Border Background="{DynamicResource ThemeSuccessBackground}" BorderBrush="{DynamicResource ThemeBorderStrong}"
                    BorderThickness="1" CornerRadius="12" Padding="14,9" HorizontalAlignment="Left" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ExecutionIndicatorDot" Width="7" Height="7" Fill="{DynamicResource ThemeAccent}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="ExecutionIndicatorText" Text="EXECUÇÃO POLYMARKET CLOB DISPONÍVEL" FontSize="10"
                               FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ThemePanel}" BorderBrush="{DynamicResource ThemeBorder}"
                    BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,6,0,0">
                <Grid>
                    <ItemsControl x:Name="CopiedTradesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:CopyTradeRecord}">
                                <Border Background="{DynamicResource ThemePanelRaised}" CornerRadius="10"
                                        Padding="16,13" Margin="0,0,0,10" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <Border Background="{DynamicResource ThemeControl}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ExecutionBadgeLabel}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                                                </Border>
                                                <TextBlock Text="{Binding WalletLabel}" FontSize="10" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{Binding MarketTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding TradeLabel}" FontSize="12" Foreground="{DynamicResource ThemeAccent}" Margin="0,5,0,0" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CopyDetailsLabel}" FontSize="11" Foreground="{DynamicResource ThemeMuted}" Margin="0,4,0,0"/>

                                            <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding ErrorMessage, Converter={x:Null}}"
                                                       FontSize="10" Foreground="{DynamicResource ThemeError}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                            <TextBlock Text="{Binding AmountLabel}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding ExecutionStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccent}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding CopiedAtLabel}" FontSize="10" Foreground="{DynamicResource ThemeMuted}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyState" Text="Nenhum trade copiado ainda."
                               Foreground="{DynamicResource ThemeSecondary}" FontSize="13"
                               HorizontalAlignment="Center" Margin="30"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
