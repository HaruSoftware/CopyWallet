<Window x:Class="WalletCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:pages="clr-namespace:WalletCopy.Pages"
        xmlns:controls="clr-namespace:WalletCopy.Controls"
        Title="Wallet Copy — Polymarket"
        Width="1460" Height="940" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="{DynamicResource AppIcon}"
        Background="{DynamicResource ThemeBackground}" Foreground="{DynamicResource ThemeText}" FontFamily="Arial"
        ui:ThemeManager.RequestedTheme="Default"
        ui:WindowHelper.UseModernWindowStyle="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeNav}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeControl}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemePanelRaised}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="Margin" Value="0,15"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource ThemeSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,18,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="{DynamicResource ThemeSuccessBackground}" CornerRadius="11">
                            <TextBlock Text="W" Foreground="{DynamicResource ThemeAccent}" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="wallet copy" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="POLYMARKET TERMINAL" FontSize="8"
                                       Foreground="{DynamicResource ThemeSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
                    <Border Background="{DynamicResource ThemeControl}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SidebarModeDot" Width="7" Height="7" Fill="{DynamicResource ThemeAccent}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SidebarModeTitle" Text="MODO CONSULTA / PAPER" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource ThemeAccent}"/>
                            </StackPanel>
                            <TextBlock Text="Acompanhamento público. Nenhuma ordem será enviada."
                                       x:Name="SidebarModeSubtitle" FontSize="10" Foreground="{DynamicResource ThemeSecondary}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.0.0  ·  Polymarket Data API" FontSize="9"
                               Foreground="{DynamicResource ThemeDim}" Margin="5,14,0,0"/>
                </StackPanel>
                <StackPanel Margin="12,0">
                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeLabel}" Margin="10,0,0,10"/>
                    <Button x:Name="DashboardNavigation" Style="{StaticResource NavigationButton}"
                            Tag="Dashboard" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Dashboard" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Visão geral" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WalletsNavigation" Style="{StaticResource NavigationButton}"
                            Tag="Wallets" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Briefcase" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Carteiras" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WalletAnalysisNavigation" Style="{StaticResource NavigationButton}"
                            Tag="WalletAnalysis" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Search" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Análise de carteira" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MarketsNavigation" Style="{StaticResource NavigationButton}" Visibility="Collapsed"
                            Tag="Markets" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="BarChart" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Mercados" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PaperTradingNavigation" Style="{StaticResource NavigationButton}"
                            Tag="PaperTrading" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Exchange" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Terminal simulado" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ArbitrageNavigation" Style="{StaticResource NavigationButton}"
                            Tag="ArbitrageMonitor" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="LineChart" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Monitor de book" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CopyTradesNavigation" Style="{StaticResource NavigationButton}"
                            Tag="CopyTrades" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Exchange" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Trades copiados" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Divider}"/>
                    <Button x:Name="SettingsNavigation" Style="{StaticResource NavigationButton}"
                            Tag="Settings" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Cog" Width="16" Height="16"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,12,0"/>
                            <TextBlock Text="Configurações" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="DADOS PÚBLICOS" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeLabel}" Margin="10,0,0,9"/>
                    <StackPanel Orientation="Horizontal" Margin="11,4,0,0">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{DynamicResource ThemePending}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionStatus" Text="Conectando…"
                                   FontSize="10" Foreground="{DynamicResource ThemeSecondary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="154"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ThemeSidebar}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Workspace" FontSize="12" Foreground="{DynamicResource ThemeSecondary}"/>
                        <TextBlock Text="  /  " FontSize="12" Foreground="{DynamicResource ThemeDim}"/>
                        <TextBlock x:Name="CurrentPageTitle" Text="Visão geral"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="CurrentWalletLabel" Grid.Column="1" Text=""
                               FontSize="10" Foreground="{DynamicResource ThemeSecondary}" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="3" Background="{DynamicResource ThemeControl}"
                            Height="36" MinWidth="112" Padding="10,0" FontSize="11"
                            HorizontalContentAlignment="Center" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Refresh" Width="12" Height="12"
                                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                             Margin="0,0,8,0"/>
                            <TextBlock Text="Atualizar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1"/>
            <controls:NotificationHost x:Name="NotificationPopup" Grid.RowSpan="2"
                                       Panel.ZIndex="20" IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Window>
