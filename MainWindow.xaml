<Window x:Class="WalletCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:pages="clr-namespace:WalletCopy.Pages"
        xmlns:controls="clr-namespace:WalletCopy.Controls"
        Title="Wallet Copy — Polymarket"
        Width="1460" Height="940" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D12" Foreground="#F4F5F7" FontFamily="Arial"
        ui:ThemeManager.RequestedTheme="Dark"
        ui:WindowHelper.UseModernWindowStyle="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAB0BD"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#242936"/>
            <Setter Property="Margin" Value="0,15"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E1118" BorderBrush="#202530" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,18,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="#1B372D" CornerRadius="11">
                            <TextBlock Text="W" Foreground="#64E2A2" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="wallet copy" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="POLYMARKET TERMINAL" FontSize="8"
                                       Foreground="#8C93A3" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,18">
                    <Border Background="#141922" BorderBrush="#242936" BorderThickness="1"
                            CornerRadius="12" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#64E2A2" Margin="0,0,8,0"/>
                                <TextBlock Text="SOMENTE LEITURA" FontSize="9" FontWeight="Bold"
                                           Foreground="#64E2A2"/>
                            </StackPanel>
                            <TextBlock Text="Acompanhamento público. Nenhuma ordem será enviada."
                                       FontSize="10" Foreground="#8C93A3" TextWrapping="Wrap"
                                       Margin="0,8,0,0" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.0.0  ·  Polymarket Data API" FontSize="9"
                               Foreground="#626A7A" Margin="5,14,0,0"/>
                </StackPanel>
                <StackPanel Margin="12,0">
                    <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                               Foreground="#687081" Margin="10,0,0,10"/>
                    <Button x:Name="DashboardNavigation" Style="{StaticResource NavigationButton}"
                            Content="◉     Visão geral" Tag="Dashboard" Click="Navigate_Click"/>
                    <Button x:Name="WalletsNavigation" Style="{StaticResource NavigationButton}"
                            Content="▣     Carteiras" Tag="Wallets" Click="Navigate_Click"/>
                    <Button x:Name="MarketsNavigation" Style="{StaticResource NavigationButton}"
                            Content="◎     Mercados" Tag="Markets" Click="Navigate_Click"/>
                    <Button x:Name="CopyTradesNavigation" Style="{StaticResource NavigationButton}"
                            Content="⇄     Trades copiados" Tag="CopyTrades" Click="Navigate_Click"/>
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Text="DADOS PÚBLICOS" FontSize="9" FontWeight="Bold"
                               Foreground="#687081" Margin="10,0,0,9"/>
                    <StackPanel Orientation="Horizontal" Margin="11,4,0,0">
                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#E8B867"
                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnectionStatus" Text="Conectando…"
                                   FontSize="10" Foreground="#8C93A3"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="154"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0E1118" BorderBrush="#202530" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Workspace" FontSize="12" Foreground="#8C93A3"/>
                        <TextBlock Text="  /  " FontSize="12" Foreground="#4F5664"/>
                        <TextBlock x:Name="CurrentPageTitle" Text="Visão geral"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="CurrentWalletLabel" Grid.Column="1" Text=""
                               FontSize="10" Foreground="#8C93A3" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="3" Content="↻  Atualizar" Background="#1B212C"
                            Padding="13,8" Click="Refresh_Click"/>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1"/>
            <controls:NotificationHost x:Name="NotificationPopup" Grid.RowSpan="2"
                                       Panel.ZIndex="20" IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Window>
